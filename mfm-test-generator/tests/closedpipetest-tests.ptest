// tests appended to the file generated by mfm-test-generator: inner and
// outer displacements and axial strain given by the Lame solution of a
// closed pipe (end cap effect)
@Real 'Pi1' 1.5e6;
@Real 'Pe1' 10e6;
@Test<function> 'InnerDisplacement' 'Ri/YoungModulus*t*((Pi1*(Ri*Ri+Re*Re)-2*Pe1*Re*Re)/(Re*Re-Ri*Ri)+PoissonRatio*Pi1-PoissonRatio*(Pi1*Ri*Ri-Pe1*Re*Re)/(Re*Re-Ri*Ri))' 1.e-10;
@Test<function> 'OuterDisplacement' 'Re/YoungModulus*t*((2*Pi1*Ri*Ri-Pe1*(Ri*Ri+Re*Re))/(Re*Re-Ri*Ri)+PoissonRatio*Pe1-PoissonRatio*(Pi1*Ri*Ri-Pe1*Re*Re)/(Re*Re-Ri*Ri))' 1.e-10;
@Test<function> 'AxialGrowth' '(1-2*PoissonRatio)/YoungModulus*t*(Pi1*Ri*Ri-Pe1*Re*Re)/(Re*Re-Ri*Ri)' 1.e-10;
