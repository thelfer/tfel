# Official Fedora packaging for TFEL/MFront.
# See https://github.com/thelfer/tfel/issues/1468 for the packaging
# strategy and packages/fedora/README.md for build instructions.
#
# Upstream release tags are named `TFEL-<version>` (e.g. TFEL-4.2.5).
# To package a newer release:
#
#   ./update-release.sh <version>
#
# which downloads the archive into SOURCES/, refreshes the
# `tfel_version` global below and rewrites the `sources` file (md5 +
# archive name, the format used by Fedora dist-git and `rpkg`).

# Version of the release being packaged. The conditional form allows
# an override on the command line
# (`rpmbuild --define 'tfel_version 5.2.0' ...`) to test the packaging
# of unreleased sources; `update-release.sh` keeps it in sync with the
# `sources` file.
%{!?tfel_version: %global tfel_version 4.2.5}

# python bindings are not packaged yet: the install path must be aligned
# with Fedora's layout (see the notes at the end of this file and #1466).
%bcond_with python
# the unit tests are run by `%%check` (see the comment in that section);
# continuous integration jobs may disable them with `--without check`
%bcond_without check

Name:           tfel
Version:        %{tfel_version}
Release:        1%{?dist}
Summary:        Numerical library for material laws and MFront code generator
License:        GPL-2.0-or-later WITH Classpath-exception-2.0 OR CECILL-2.1
# The sources are dual licensed: the GNU GPL (version 2 or later) *with*
# a "linking exception" allowing code built with TFEL to remain
# proprietary, or the CECILL-A (v2.1) licence, which is explicitly
# compatible with the GNU GPL. The linking exception is functionally
# close to the GNU Classpath exception; the exact license expression is
# to be confirmed with Fedora Legal during the review (see #1468).
URL:            https://thelfer.github.io/tfel/web/index.html
Source0:        https://github.com/thelfer/tfel/archive/refs/tags/TFEL-%{version}.tar.gz
# Note: the `sources` file next to this spec (md5 + archive name, the
# Fedora dist-git format) is packaging metadata, not a Source: place the
# archive in SOURCES/ (see `update-release.sh`).

BuildRequires:  cmake >= 3.20
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  gcc-gfortran
BuildRequires:  make
BuildRequires:  python3-devel
%if %{with python}
BuildRequires:  pybind11-devel
BuildRequires:  python3-numpy
%endif

Requires:       mfront = %{version}-%{release}
Recommends:     mtest = %{version}-%{release}

%global tfel_description \
TFEL is a numerical library developed by CEA and EDF. It provides\
the infrastructure to implement material knowledge (material\
properties, mechanical behaviours, heat transfer laws, etc.) in a way\
which is independent from any solver.\
\
Material laws written with the MFront domain specific languages are\
translated into C++ code built on top of the TFEL library.

%global tools_description \
This package contains the dedicated tools of TFEL:\
\
* mfront: the code generator translating the MFront domain specific\
languages into plain C++,\
* mfront-query and mfront-doc: query and documentation tools for\
MFront behaviours,\
* mtest: a unified thermomechanical testing solver for material\
behaviours,\
* tfel-config: a tool reporting the installation characteristics of\
TFEL (used by MFront to find the library),\
* tfel-check and tfel-unicode-filt: validation tools.

%description
%tfel_description

%package devel
Summary:        Development files for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description devel
%tfel_description
.
This package contains the header files required to compile material
laws generated by MFront and to develop applications using the TFEL
library. It is also required by MFront and MTest to compile behaviours
on the fly.

%package mfront
Summary:        Code generator for material laws
Requires:       %{name}%{?_isa} = %{version}-%{release}
# mfront invokes the system C++ compiler to build the generated
# interfaces (--obuild option)
Recommends:     gcc-c++
Recommends:     %{name}-devel = %{version}-%{release}

%description mfront
%tfel_description
.
MFront is a code generator which translates a set of closely related
domain specific languages into plain C++ on top of the TFEL library.
Those languages cover material properties, mechanical behaviours and
simple point-wise models.
.
MFront offers interfaces to finite element solvers such as Cast3M,
Code_Aster, Abaqus, CalculiX, Cyrano, MFront generic interface, etc.

%package mtest
Summary:        Mechanical testing solver for material laws
Requires:       %{name}%{?_isa} = %{version}-%{release}
Requires:       mfront = %{version}-%{release}
# mtest compiles material laws on the fly
Recommends:     gcc-c++
Recommends:     %{name}-devel = %{version}-%{release}

%description mtest
%tfel_description
.
MTest is a unified thermomechanical resolution solver for material
behaviours. It can run most of the tests conducted in material
characterization (stress/strain controlled tests, cyclic loading,
relaxation, creep, etc.) and can be used either as a standalone
solver or as a post processing tool.

%package check
Summary:        Validation suite for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description check
%tfel_description
.
This package contains the `tfel-check` validation suite and the
associated test files.

# TODO (second iteration, see #1468): add a python3-tfel subpackage:
#
#   %%define with_python 1
#   a `python3-tfel` subpackage using %%python_provide, pybind11-devel
#   and python3-numpy, installing the bindings in
#   %%{python3_sitelib} (the `TFEL_PYTHON_SITE_PACKAGES_DIR` CMake
#   variable is already overridable; upstream should honour
#   `CMAKE_INSTALL_PYTHONDIR` instead, see #1466).

%prep
# the GitHub archive expands to `tfel-TFEL-<version>/`
%autosetup -n tfel-TFEL-%{version}

%build
# - TFEL installs libraries in `lib${LIB_SUFFIX}` instead of honouring
#   GNUInstallDirs (`CMAKE_INSTALL_LIBDIR`): LIB_SUFFIX=64 makes them
#   land in `%{_libdir}` on multilib architectures; an upstream fix
#   to honour CMAKE_INSTALL_LIBDIR is to be proposed (same issue as
#   Debian multiarch, see #1466 and #1468).
# - enable-portable-build: forbids `-march=native`, which is required
#   by Fedora's guidelines for binaries distributed in the repository.
# - TFEL_APPEND_VERSION=OFF: unversioned install tree
#   (`/usr/include/TFEL`, `/usr/share/tfel`, SONAMEs without flavour
#   suffix).
%cmake \
    -DLIB_SUFFIX=64 \
    -Denable-portable-build=ON \
    -Denable-fortran=ON \
    -Denable-python=%{?with_python:ON}%{!?with_python:OFF} \
    -Denable-python-bindings=%{?with_python:ON}%{!?with_python:OFF} \
    -Denable-reference-doc=OFF \
    -Denable-website=OFF \
    -DTFEL_APPEND_VERSION=OFF
%cmake_build

%install
%cmake_install
# the licences are shipped through %%licence below; the `web` tree is a
# duplicate of the `mfront` gallery (it feeds the website, which will go
# to a future `tfel-doc` package)
rm -rf %{buildroot}%{_docdir}/tfel
# `Fedora` doc directories are versioned per package: relocate the
# unversioned trees installed by the build (portable across rpm
# versions, unlike entries prefixed by %%{buildroot})
for d in mfront mtest; do
  if [ -d %{buildroot}%{_docdir}/${d} ]; then
    mkdir -p %{buildroot}%{_docdir}/${d}-%{version}
    mv %{buildroot}%{_docdir}/${d}/* \
       %{buildroot}%{_docdir}/${d}-%{version}/
    rmdir %{buildroot}%{_docdir}/${d}
  fi
done

%check
%if %{with check}
# TFEL registers thousands of tests, but the executables are
# EXCLUDE_FROM_ALL and the `generic-*`/`mfront-*`/`*_mtest` matrices
# (more than 6000 tests) need `tfel-config` and `mfront` from an
# *installed* tree: they are run by the upstream CI (`check_all.sh`)
# and can be run after installation with the `tfel-check` package, see
# #1468.
#
# What is run here is the set of self-contained unit tests of the
# libraries (their names have neither `-` nor the `_mtest` suffix):
# 222 tests on 4.2.5 (3 min to build, 5 s to run) and 264 on 5.2
# (4 min to build, 9 s to run), all passing in both cases.
%global tfel_unit_tests ^[A-Za-z0-9_]+$
tfel_test_targets=$(%{__ctest} --test-dir %{_vpath_builddir} -N \
                      -R '%{tfel_unit_tests}' -E '_mtest$' 2>/dev/null |
                     sed -n 's/^ *Test *#[0-9]*: *//p' | sort -u)
if [ -n "${tfel_test_targets}" ]; then
  %{__cmake} --build %{_vpath_builddir} --target ${tfel_test_targets} \
             --parallel %{_smp_build_ncpus}
  %ctest -R '%{tfel_unit_tests}' -E '_mtest$' --output-on-failure \
         --parallel %{_smp_build_ncpus}
fi
%endif

%ldconfig_scriptlets

%files
# relative paths: the licences live at the top of the sources and are
# staged into %%{_licensedir} by rpm during %%install (requires the
# license staging of Fedora's rpm; on non-Fedora rpm builds a buildroot
# path must be used instead)
%license LICENCE-GNU-GPL
%license LICENCE-CECILL-A-EN
%license LICENCE-CECILL-A-FR
%{_libdir}/lib*.so.*
# TFEL >= 5.2 additionally installs `share/tfel/env` (shell/fish
# environment helpers): claim it here when packaging a 5.2 release
# (`update-release.sh` and the unpackaged files check will point it
# out). It is not installed by 4.2.5 when no solver interface is
# enabled, so it cannot be listed unconditionally.

%files devel
%{_includedir}/TFEL/
%{_includedir}/MFront/
%{_includedir}/MTest/
%{_includedir}/MFMTestGenerator/
%{_includedir}/NUMODIS/
%{_includedir}/Cyrano/
# bundled third-party code, LGPL-2.1+ (see #1466): must be documented
# separately in a review submission
%{_includedir}/FSES/
%{_libdir}/lib*.so
%dir %{_datadir}/tfel
%{_datadir}/tfel/cmake/
%{_bindir}/tfel-config

%files mfront
%{_bindir}/mfront
%{_bindir}/mfront-query
%{_bindir}/mfront-doc
%{_bindir}/mfm
%{_bindir}/mfm-test-generator
%{_bindir}/tfel-doc
# documentation and gallery of `MFront` (installed unversioned by the
# build, relocated in %%install)
%doc %{_docdir}/mfront-%{version}

%files mtest
%{_bindir}/mtest
%doc %{_docdir}/mtest-%{version}

%files check
%{_bindir}/tfel-check
%{_bindir}/tfel-unicode-filt
%{_datadir}/tfel/test-suite/

