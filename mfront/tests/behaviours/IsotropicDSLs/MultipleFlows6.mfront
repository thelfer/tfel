@DSL MultipleIsotropicMisesFlows;
@Behaviour MultipleFlows6;
@Author Tristan Chenaille;
@Date 14 / 11 / 2026;
@Description {
  "Behaviour combining a plastic flow, a creep flow and a strain hardening "
  "creep flow, used to check the consistent tangent operator. The plastic "
  "flow is evaluated at the end of the time step through a value of theta "
  "specific to this flow."
}

@Epsilon 1e-14;
@UseQt true;
@Theta 0.5;

@ElasticMaterialProperties{150.e9, 0.3};

@IsotropicHardeningRule "Voce" {flow_id : 0, R0 : 125e6, Rinf : 500e6, b : 20};

@FlowRule Plasticity 1 {
  f = seq - R;
  df_dseq = 1;
  df_dp = -dR_dp;
}

@FlowRule Creep {
  constexpr auto de0 = strainrate{1e-6};
  constexpr auto s0 = stress{100e6};
  constexpr auto E = real{5};
  const auto tmp = de0 * pow(seq / s0, E - 1);
  f = tmp * seq / s0;
  df_dseq = E * tmp / s0;
}

@FlowRule StrainHardeningCreep {
  constexpr auto de0 = strainrate{2e-6};
  constexpr auto s0 = stress{150e6};
  constexpr auto pr = strain{1e-3};
  constexpr auto E = real{3};
  const auto tmp = de0 * pow(seq / s0, E - 1) / (1 + p / pr);
  f = tmp * seq / s0;
  df_dseq = E * tmp / s0;
  df_dp = -f / (pr * (1 + p / pr));
}
