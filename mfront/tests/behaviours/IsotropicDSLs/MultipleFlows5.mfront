@DSL MultipleIsotropicMisesFlows;
@Behaviour MultipleFlows5;
@Description {
  "Behaviour Plasticity6 written with the MultipleIsotropicMisesFlows DSL. "
  "The flow and its isotropic hardening rule are evaluated at the end of "
  "the time step, as in Plasticity6, through the value of theta specific "
  "to the flow."
}

@Epsilon 1e-15;
@UseQt true;
@Theta 0.5;

@ElasticMaterialProperties{150.e9, 0.3};

@IsotropicHardeningRule "Linear" {flow_id : 0, R0 : 102e6, H : 102e9};

@FlowRule Plasticity 1 {
  f = seq - R;
  df_dseq = 1;
  df_dp = -dR_dp;
}
