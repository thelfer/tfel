@DSL Implicit;
@Behaviour MichelAndSuquet1992HollowSphereTest_qt;
@Author Tristan Chenaille;
@Date 03 / 11 / 2026;
@UseQt true;
@Description {
  The Michel and Suquet 1992 hollow sphere criterion with quantities.
}

@ModellingHypotheses {".+"};
@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 150e9, poisson_ratio : 0.3},
  inelastic_flow : "Norton" {
    criterion : "MichelAndSuquet1992HollowSphere" {n : 3},
    K : 100e6,
    n : 3
  }
};
