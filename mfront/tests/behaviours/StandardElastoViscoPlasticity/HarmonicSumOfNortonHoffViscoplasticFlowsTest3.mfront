@DSL Implicit;
@Behaviour HarmonicSumOfNortonHoffViscoplasticFlowsTest3;
@Author Tristan Chenaille;
@Date 03 / 11 / 2026;
@Description {
  Two Norton-Hoff flows with different exponents. Under a nearly
  hydrostatic loading, the strain rate of the second flow is so small
  that its square underflows.
}

@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 150e9, poisson_ratio : 0.3},
  inelastic_flow : "HarmonicSumOfNortonHoffViscoplasticFlows" {
    criterion : "Mises",
    A : {1, 1},
    K : {100e6, 100e6},
    n : {3, 20}
  }
};
