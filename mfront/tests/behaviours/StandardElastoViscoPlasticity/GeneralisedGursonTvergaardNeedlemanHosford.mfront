@DSL Implicit;
@Behaviour GeneralisedGursonTvergaardNeedlemanHosford;
@Author Tristan Chenaille;
@Date 14 / 11 / 2026;
@Description {
  "The GeneralisedGursonTvergaardNeedleman criterion built on the "
  "Hosford stress with an exponent equal to 2, which must give the "
  "results of the GursonTvergaardNeedleman1982 criterion."
}

@ModellingHypotheses{".+"};

@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 200e3, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "GeneralisedGursonTvergaardNeedleman" {
      f_c : 0.01,
      f_r : 0.10,
      q_1 : 2,
      q_2 : 1,
      q_3 : 4,
      equivalent_stress : "Hosford" {a : 2, eigen_solver : "Jacobi"}
    },
    isotropic_hardening : "Linear" {R0 : 200.}
  }
};
