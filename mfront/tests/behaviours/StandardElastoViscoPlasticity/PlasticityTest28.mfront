@DSL Implicit;
@Behaviour PlasticityTest28;
@Description {
  "Burlet-Cailletaud kinematic hardening rule with a non zero eta coefficient."
}

@ModellingHypotheses {".+"};
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 160e9, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "Mises",
    isotropic_hardening : "Linear" {R0 : 120e6},
    kinematic_hardening : "Burlet-Cailletaud" {C : 250e7, D : 100, eta : 0.3}
  }
};
