@DSL Implicit;
@Behaviour GursonTvergaardNeedleman1982_qt;
@Author Tristan Chenaille;
@Date 03 / 11 / 2026;
@UseQt true;
@Description {
  The Gurson-Tvergaard-Needleman 1982 criterion with quantities.
}

@ModellingHypotheses{".+"};

@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 200e3, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "GursonTvergaardNeedleman1982" {
      f_c : 0.01,
      f_r : 0.10,
      q_1 : 2,
      q_2 : 1,
      q_3 : 4
    },
    isotropic_hardening : "Linear" {R0 : 200.}
  }
};
