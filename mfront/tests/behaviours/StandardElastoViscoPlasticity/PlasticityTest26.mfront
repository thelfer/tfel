@DSL Implicit;
@Behaviour PlasticityTest26;
@Description {
  "User defined isotropic hardening rule, as in the example of the "
  "documentation of the StandardElastoViscoPlasticity brick."
}

@ModellingHypotheses {".+"};
@Epsilon 1.e-14;
@Theta 1;

@Parameter stress R0 = 200e6;
@Parameter stress Hy = 40e6;
@Parameter real b = 100;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 150e9, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "Mises",
    isotropic_hardening : "UserDefined" {
      R : "R0 + Hy * (1 - exp(-b * p))",
      dR_dp : "b * (R0 + Hy - R)"
    }
  }
};
