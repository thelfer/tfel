@DSL Implicit;
@Behaviour GeneralisedGursonTvergaardNeedlemanHill;
@Author Tristan Chenaille;
@Date 14 / 11 / 2026;
@Description {
  "The GeneralisedGursonTvergaardNeedleman criterion built on the Hill "
  "stress with the coefficients of an isotropic material, which must "
  "give the results of the GursonTvergaardNeedleman1982 criterion."
}

@ModellingHypotheses{".+"};

@OrthotropicBehaviour<Pipe>;
@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 200e3, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "GeneralisedGursonTvergaardNeedleman" {
      f_c : 0.01,
      f_r : 0.10,
      q_1 : 2,
      q_2 : 1,
      q_3 : 4,
      equivalent_stress : "Hill" {F : 0.5, G : 0.5, H : 0.5, L : 1.5, M : 1.5, N : 1.5}
    },
    isotropic_hardening : "Linear" {R0 : 200.}
  }
};
