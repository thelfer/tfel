@DSL Implicit;
@Behaviour TensorialIntegrationVariablesPartialJacobianInvert;
@Author Tristan Chenaille;
@Date 22/11/2026;
@Description {
  "This behaviour is used to test the `getPartialJacobianInvert` function "
  "object when a tensorial integration variable follows another one. The "
  "elastic strain is the total strain minus a fraction of a symmetric "
  "tensor whose rate is proportional to the elastic strain. A scalar, "
  "whose rate is proportional to the trace of the elastic strain, follows "
  "this tensor. The blocks of the inverse of the jacobian are compared to "
  "their analytical values when the tangent operator is computed."
}

@Epsilon 1.e-14;
@Theta 0.5;

@Parameter stress young = 150e9;
young.setGlossaryName("YoungModulus");
@Parameter real nu = 0.3;
nu.setGlossaryName("PoissonRatio");
@Parameter real c = 0.5;
@Parameter real k = 15;
@Parameter real m = 2;

@StateVariable Stensor a;
@StateVariable real p;

@LocalVariable stress lambda;
@LocalVariable stress mu;

@InitLocalVariables {
  lambda = computeLambda(young, nu);
  mu = computeMu(young, nu);
}

@ComputeFinalStress {
  sig = lambda * trace(eel) * Stensor::Id() + 2 * mu * eel;
}

@Integrator {
  const auto e = eel + theta * deel;
  feel += c * da - deto;
  dfeel_dda = c * Stensor4::Id();
  fa -= k * dt * e;
  dfa_ddeel = -k * dt * theta * Stensor4::Id();
  fp -= m * dt * trace(e);
  dfp_ddeel = -m * dt * theta * Stensor::Id();
}

@TangentOperator {
  static_cast<void>(smt);
  Stensor4 Je;
  Stensor4 Ja;
  Stensor Jp;
  getPartialJacobianInvert(Je, Ja, Jp);
  // The jacobian being made of multiples of the identity, the blocks of
  // its inverse are known: the integration fails if the blocks returned
  // differ from them.
  constexpr auto eps = real(1.e-12);
  const auto s = k * dt * theta;
  const auto r = 1 / (1 + c * s);
  if ((abs(Je - r * Stensor4::Id()) > eps) ||
      (abs(Ja - s * r * Stensor4::Id()) > eps) ||
      (abs(Jp - m * dt * theta * r * Stensor::Id()) > eps)) {
    return false;
  }
  StiffnessTensor De;
  computeElasticStiffness<N, Type>::exe(De, lambda, mu);
  Dt = De * Je;
}
