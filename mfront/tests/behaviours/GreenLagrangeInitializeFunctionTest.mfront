@DSL Default;
@Behaviour GreenLagrangeInitializeFunctionTest;
@Description {
  "Test of the initialize functions of the generic interface for "
  "behaviours based on the Green-Lagrange strain measure: the second "
  "Piola-Kirchhoff stress computed by the initialize function must "
  "be returned in the stress measure of the caller."
}

@ModellingHypothesis Tridimensional;
@StrainMeasure GreenLagrange;

@ProvidesSymmetricTangentOperator;
@Integrator {
  sig = 150e9 * (eto + deto);
  if (computeTangentOperator_) {
    Dt = 150e9 * Stensor4::Id();
  }
}

@InitializeFunctionVariable stress pr;
//! \brief initialize the second Piola-Kirchhoff stress from a pressure
@InitializeFunction StressFromPressure {
  sig = pr * Stensor::Id();
}
