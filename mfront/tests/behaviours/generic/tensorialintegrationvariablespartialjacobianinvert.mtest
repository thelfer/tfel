@Author Tristan Chenaille;
@Date 22/11/2026;
@Description{
  "This test checks the blocks of the inverse of the jacobian computed by "
  "the TensorialIntegrationVariablesPartialJacobianInvert behaviour, "
  "which compares them to their analytical values and fails otherwise, "
  "and the evolution of its state variables."
};

@XMLOutputFile @xml_output@;
@MaximumNumberOfSubSteps 1;
@Behaviour<generic> @library@ 'TensorialIntegrationVariablesPartialJacobianInvert';

@ExternalStateVariable 'Temperature' 293.15;

@ImposedStrain 'EXX' {0 : 0, 1 : 1.e-3};
@ImposedStrain 'EYY' {0 : 0, 1 : -4.e-4};
@ImposedStrain 'EZZ' {0 : 0, 1 : 2.e-4};
@ImposedStrain 'EXY' {0 : 0, 1 : 3.e-4};
@ImposedStrain 'EXZ' {0 : 0, 1 : -2.e-4};
@ImposedStrain 'EYZ' {0 : 0, 1 : 1.e-4};

@Times {0, 1 in 5};

// The implicit scheme (theta = 1/2, time steps of length 0.2) leads to a
// linear recurrence whose solution, at the end of the time steps, is given
// by the functions below, the ratio of the geometric part being 1/7.
@Real 'c' 0.5;
@Real 'k' 15;
@Real 'm' 2;
@Real 'tr' '1.e-3 - 4.e-4 + 2.e-4';
@Test<function> {
  'aXX' : '1.e-3 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))',
  'aYY' : '-4.e-4 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))',
  'aZZ' : '2.e-4 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))',
  'aXY' : '3.e-4 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))',
  'aXZ' : '-2.e-4 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))',
  'aYZ' : '1.e-4 * (t / c - (1 - 7 ** (-5 * t)) / (c * c * k))'
} 1.e-14;
@Test<function> 'p' 'm * tr * (t - 2 * (1 - 7 ** (-5 * t)) / 15) / (c * k)' 1.e-14;
