@Author Tristan Chenaille;
@Date 25/10/2026;
@XMLOutputFile @xml_output@;
@MaximumNumberOfSubSteps 1;
@Behaviour<generic> @library@ 'RungeKuttaElasticity_rk4';

@ExternalStateVariable 'Temperature' {0 : 293.15, 1 : 793.15};
@Evolution<function> 'E' '150e9 * (1 - Temperature / 2e3)';

@ImposedStrain 'EXX' {0 : 0, 1 : 1e-3};
@Times {0, 1 in 10};

@Test<function> 'SXX' 'E * EXX' 1e-2;
