@DSL Implicit;
@Behaviour WarningTest87;
@Description {
  "This test checks that the `safe` option disables the warning "
  "reported if the `TDLS` linear solver is selected while MFront "
  "was not built with TDLS support."
}

@Epsilon 1e-14;
@LinearSystemSolver<safe> TDLS;
@Brick StandardElasticity;
