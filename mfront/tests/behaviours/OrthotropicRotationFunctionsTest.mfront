@DSL DefaultGenericBehaviour;
@Behaviour OrthotropicRotationFunctionsTest;
@Description {
  "An orthotropic behaviour with two tensorial gradients, used to test the "
  "rotation functions generated by the generic interface."
}

@OrthotropicBehaviour;

@Gradient Stensor e;
@Flux Stensor sig;
@Gradient Tensor f;
@Flux Tensor tau;

@TangentOperatorBlocks{dsig_dde, dtau_ddf, dsig_ddT};

@Integrator {
  sig = e + de;
  tau = f + df;
}

@TangentOperator {
  static_cast<void>(smt);
  dsig_dde = Stensor4::Id();
  dtau_ddf = tfel::math::t2tot2<N, real>::Id();
  dsig_ddT = Stensor(real(0));
}
