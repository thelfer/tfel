/*!
 * \file   ImplicitNorton2_qt.mfront
 * \brief  same as ImplicitNorton2, with quantities: arrays of scalar and
 * tensorial state variables with `@UseQt true`
 */

@DSL Implicit;
@Behaviour ImplicitNorton2_qt;
@UseQt true;
@Author Tristan Chenaille;
@Date 03/11/2026;

@Brick StandardElasticity;
@Epsilon 1.e-14;

@MaterialProperty stress young;
young.setGlossaryName("YoungModulus");
@MaterialProperty real nu;
nu.setGlossaryName("PoissonRatio");

@LocalVariable stress lambda;
@LocalVariable stress mu;

// the Norton law is split in two identical mechanisms
@StateVariable strain p[2];
p.setGlossaryName("EquivalentViscoplasticStrain");
@StateVariable StrainStensor evp[2];
evp.setGlossaryName("ViscoplasticStrain");

@InitLocalVariables {
  lambda = computeLambda(young, nu);
  mu = computeMu(young, nu);
}

@Integrator {
  // creep rate of each mechanism: de0 * (seq / s0) ** E
  constexpr auto s0 = stress(100e6);
  constexpr auto de0 = strainrate(0.15924286822139683);
  constexpr auto E = real(8.2);
  const auto seps = real(1.e-12) * young;
  const auto seq = sigmaeq(sig);
  const auto rseq = seq / s0;
  const auto iseq = 1 / (std::max(seq, seps));
  const auto n = 3 * deviator(sig) * (iseq / 2);
  const auto tmp = de0 * pow(rseq, E - 1);
  const auto dn_ddeel = 2 * mu * theta * iseq * (Stensor4::M() - (n ^ n));
  for (ushort i = 0; i != 2; ++i) {
    // elasticity
    feel += devp[i];
    // viscoplasticity
    fevp[i] -= dp[i] * n;
    fp[i] -= tmp * rseq * dt;
    // jacobian
    dfeel_ddevp(i) = Stensor4::Id();
    dfevp_ddp(i, i) = -n;
    dfevp_ddeel(i) = -dp[i] * dn_ddeel;
    dfp_ddeel(i) = -2 * theta * (mu / s0) * E * tmp * dt * n;
  }
}  // end of @Integrator
