dsl_options: {
  disable_runtime_checks: false
},
interfaces_options: {
  generic-parallel: {
    backend: {hip: {
        number_of_threads_per_block: 64
      }
    }
  }
},
compilation_options : {
  hip: {
    compiler: "@TFEL_HIPCC_COMPILER@",
    compilation_flags: "@TFEL_HIPCC_FLAGS@ --std=c++@TFEL_CXX_STANDARD@"
  }
}