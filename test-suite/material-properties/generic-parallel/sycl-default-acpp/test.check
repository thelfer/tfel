@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::sycl-default-acpp"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../BoundsOrderTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../LinearDataInterpolationTest.mfront";
@Command "@mfront@ --obuild --configuration-file=config-sycl-default-acpp.json";

@Command "@TFEL_ACPP_COMPILER@ -I @TFEL_INCLUDE_DIR@ -I include -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ ../test-sycl.cxx -o test-sycl -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelUO2-sycl -lGenericParallelInconel600-sycl -lGenericParallelMaterialLaw-sycl";
@Command "./test-sycl test-sycl-default-acpp";

@Command "@TFEL_ACPP_COMPILER@ -I @TFEL_INCLUDE_DIR@ -DTFEL_SYCL_DEVICE=0 -DTFEL_SYCL_USM_ALLOCATOR=0 -I include -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ ../test-sycl-usm.cxx -o test-sycl-usm-0-0 -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelUO2-sycl -lGenericParallelInconel600-sycl -lGenericParallelMaterialLaw-sycl";
@Command "./test-sycl-usm-0-0 test-sycl-usm-default-acpp-0-0";

@Command "@TFEL_ACPP_COMPILER@ -I @TFEL_INCLUDE_DIR@ -DTFEL_SYCL_DEVICE=0 -DTFEL_SYCL_USM_ALLOCATOR=1 -I include -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ ../test-sycl-usm.cxx -o test-sycl-usm-0-1 -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelUO2-sycl -lGenericParallelInconel600-sycl -lGenericParallelMaterialLaw-sycl";
@Command "./test-sycl-usm-0-1 test-sycl-usm-default-acpp-0-1";

// comparison with the `generic` interface (see compare.cxx)
@Command "sh ../build-libraries.sh @mfront@ config-sycl-default-acpp.json";
@Command "@TFEL_ACPP_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_COMPARE_USE_SYCL -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../compare-all.sh ./compare sycl";
@Command "@TFEL_ACPP_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_COMPARE_USE_SYCL -DMFRONT_GPMP_COMPARE_USE_HOST_MEMORY -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare-host -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../compare-all.sh ./compare-host sycl";

// compilation with the runtime checks disabled
@Command "sh ../build-no-runtime-checks.sh @mfront@ config-sycl-default-acpp.json";
@Command "@TFEL_ACPP_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_COMPARE_USE_SYCL -DMFRONT_GPMP_TEST_BACKEND=sycl -I @TFEL_INCLUDE_DIR@ -I include ../test-no-runtime-checks.cxx -o test-no-runtime-checks -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelInconel600-sycl -ldl";
@Command "./test-no-runtime-checks test-no-runtime-checks-sycl-default-acpp";

@CleanFiles {"test-sycl", "compare", "compare-host", "test-no-runtime-checks", "no-runtime-checks.json"};
@CleanDirectories {"include", "src"};