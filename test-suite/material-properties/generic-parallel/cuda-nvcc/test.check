@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::cuda-nvcc"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../BoundsOrderTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../LinearDataInterpolationTest.mfront";
@Command "@mfront@ --obuild --configuration-file=config-cuda-nvcc.json";
@Command "@TFEL_NVCC_COMPILER@ -O3 --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ -I include ../test-cuda.cu -o test-cuda -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelUO2-cuda -lGenericParallelInconel600-cuda -lGenericParallelMaterialLaw-cuda";
@Command "./test-cuda test-cuda-nvcc";

// comparison with the `generic` interface (see compare.cxx)
@Command "sh ../build-libraries.sh @mfront@ config-cuda-nvcc.json";
@Command "@TFEL_NVCC_COMPILER@ -O2 --std=c++@TFEL_CXX_STANDARD@ -arch=native -x cu -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../compare-all.sh ./compare cuda --tolerance=1e-13";

// compilation with the runtime checks disabled
@Command "sh ../build-no-runtime-checks.sh @mfront@ config-cuda-nvcc.json";
@Command "@TFEL_NVCC_COMPILER@ -O3 --std=c++@TFEL_CXX_STANDARD@ -x cu -DMFRONT_GPMP_TEST_BACKEND=cuda -I @TFEL_INCLUDE_DIR@ -I include ../test-no-runtime-checks.cxx -o test-no-runtime-checks -L @TFEL_LIBRARY_DIR@ -lTFELTests -lMFrontGenericParallelRuntime -L src -lGenericParallelInconel600-cuda -ldl";
@Command "./test-no-runtime-checks test-no-runtime-checks-cuda-nvcc";

@CleanFiles {"compare", "test-no-runtime-checks", "no-runtime-checks.json"};
@CleanDirectories {"include", "src"};