//! \brief maximal value of the indices, meaning no point
static constexpr auto no_index =
    std::numeric_limits<mfront_gmp_size_type>::max();

//! \return the young modulus of the `UO2_YoungModulus_Martin1989` law
[[nodiscard]] static double uo2_young(const double T, const double f) {
  constexpr auto E0 = 2.2693e11;
  constexpr auto dE_dT = -1.53994698e7;
  constexpr auto d2E_dT2 = -1.9198278e4;
  constexpr auto f0 = 0.4;
  return (1 - f / f0) * (E0 + dE_dT * T + (d2E_dT2 / 2) * T * T);
}

struct GenericParallelMaterialPropertyTest : public tfel::tests::TestCase {
  GenericParallelMaterialPropertyTest()
      : tfel::tests::TestCase("MFront/MaterialProperty/GenericParallel",
                              "GenericParallelMaterialPropertyTest") {
  }  // end of GenericParallelMaterialPropertyTest

  tfel::tests::TestResult execute() override {
    this->test1();
    this->test2();
    this->test3();
    this->test4();
    this->test5();
    this->test6();
    this->test7();
    this->test8();
    this->test9();
    this->test10();
    this->test11();
    this->test12();
    this->test13();
    this->test14();
    this->test15();
    this->test16();
    TFEL_TESTS_ASSERT(
        checkGenericParallelSymbols(MFRONT_GPMP_TEST_BACKEND_NAME));
    return this->result;
  }  // end of execute

 private:
  [[nodiscard]] static double fct(const double TK) noexcept {
    const double TC = TK - 273.15;
    return (-3.1636e-3 * TC * TC - 3.8654 * TC + 2.1421e+4) * 1e7;
  }  // end of fct

  //! \brief check that the evaluation succeeded at all points
  void checkSuccess(const mfront_gpmp_OutputStatus& s, const int status) {
    TFEL_TESTS_CHECK_EQUAL(status, 0);
    TFEL_TESTS_CHECK_EQUAL(s.status, 0);
    TFEL_TESTS_CHECK_EQUAL(s.number_of_failures, mfront_gmp_size_type{0});
    TFEL_TESTS_CHECK_EQUAL(s.first_failure_index, no_index);
    TFEL_TESTS_CHECK_EQUAL(s.number_of_unreliable_results,
                           mfront_gmp_size_type{0});
    TFEL_TESTS_CHECK_EQUAL(s.first_unreliable_result_index, no_index);
    TFEL_TESTS_CHECK_EQUAL(s.bounds_status, 0);
  }  // end of checkSuccess

  // contiguous arrays
  void test1() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto output_qt = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    auto E_qt = test_vector<double>(4);
    const auto T = test_vector<double>{300, 500, 300, 800};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
                 args, contiguous<1>(), 4, policy, testExecution());
    const auto r_qt = evaluate(Inconel600_YoungModulus_qt_generic_parallel,
                               output_qt, E_qt.data(), 1, args, contiguous<1>(),
                               4, policy, testExecution());
    this->checkSuccess(output, r);
    this->checkSuccess(output_qt, r_qt);
    for (std::size_t i = 0; i != E.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
      TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[i])) < eps);
    }
  }

  // uniform argument
  void test2() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto output_qt = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    auto E_qt = test_vector<double>(4);
    const auto T = test_vector<double>{300};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto strides = std::array<mfront_gmp_size_type, 1u>{0};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
                 args, strides, 4, policy, testExecution());
    const auto r_qt =
        evaluate(Inconel600_YoungModulus_qt_generic_parallel, output_qt,
                 E_qt.data(), 1, args, strides, 4, policy, testExecution());
    this->checkSuccess(output, r);
    this->checkSuccess(output_qt, r_qt);
    for (std::size_t i = 0; i != E.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[0])) < eps);
      TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[0])) < eps);
    }
  }

  // uniform output: allowed for one point, whatever the strides of the
  // arguments
  void test3() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(1);
    const auto T = test_vector<double>{300};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    for (const auto stride : {0, 1, 3}) {
      E[0] = 0;
      const auto strides = std::array<mfront_gmp_size_type, 1u>{
          static_cast<mfront_gmp_size_type>(stride)};
      const auto r =
          evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(),
                   0, args, strides, 1, policy, testExecution());
      this->checkSuccess(output, r);
      TFEL_TESTS_ASSERT(std::abs(E[0] - fct(T[0])) < eps);
    }
  }

  // statuses of the points
  void test4() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto statuses = test_vector<int>(4, 12);
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{-300, 500, 300, 800};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
                 args, contiguous<1>(), 4, GENERIC_MATERIALPROPERTY_NONE_POLICY,
                 testExecution(), statuses.data());
    TFEL_TESTS_CHECK_EQUAL(r, -1);
    TFEL_TESTS_CHECK_EQUAL(statuses[0], -1);
    for (std::size_t i = 1; i != 4; ++i) {
      TFEL_TESTS_CHECK_EQUAL(statuses[i], 0);
      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
    }
    // warning policy: the second and the last temperatures are out of the
    // bounds of the law
    auto E2 = test_vector<double>(4);
    const auto T2 = test_vector<double>{300, 3000, 300, 100};
    const auto f2 = test_vector<double>{0, 0.1, 0.15, 0.12};
    const auto args2 = std::array<const double*, 2u>{T2.data(), f2.data()};
    const auto r2 = evaluate(UO2_YoungModulus_Martin1989_generic_parallel,
                             output, E2.data(), 1, args2, contiguous<2>(), 4,
                             GENERIC_MATERIALPROPERTY_WARNING_POLICY,
                             testExecution(), statuses.data());
    TFEL_TESTS_CHECK_EQUAL(r2, 1);
    TFEL_TESTS_CHECK_EQUAL(output.status, 1);
    TFEL_TESTS_CHECK_EQUAL(output.bounds_status, 1);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{0});
    TFEL_TESTS_CHECK_EQUAL(output.first_failure_index, no_index);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_unreliable_results,
                           mfront_gmp_size_type{2});
    TFEL_TESTS_CHECK_EQUAL(output.first_unreliable_result_index,
                           mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(
        std::string(output.msg),
        "T is over its upper bound at point 1 (0 failure(s), 2 unreliable "
        "result(s))");
    const auto expected = std::array<int, 4u>{0, 1, 0, 1};
    for (std::size_t i = 0; i != 4; ++i) {
      TFEL_TESTS_CHECK_EQUAL(statuses[i], expected[i]);
    }
  }

  // physical bound violated: as with the `generic` interface, the output is
  // `NaN` at the point where the evaluation fails
  void test5() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto output_qt = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    auto E_qt = test_vector<double>(4);
    const auto T = test_vector<double>{-300, 500, 300, 800};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
                 args, contiguous<1>(), 4, policy, testExecution());
    const auto r_qt = evaluate(Inconel600_YoungModulus_qt_generic_parallel,
                               output_qt, E_qt.data(), 1, args, contiguous<1>(),
                               4, policy, testExecution());
    for (const auto& [s, rv] :
         {std::pair{output, r}, std::pair{output_qt, r_qt}}) {
      TFEL_TESTS_CHECK_EQUAL(rv, -1);
      TFEL_TESTS_CHECK_EQUAL(s.status, -1);
      TFEL_TESTS_CHECK_EQUAL(s.number_of_failures, mfront_gmp_size_type{1});
      TFEL_TESTS_CHECK_EQUAL(s.first_failure_index, mfront_gmp_size_type{0});
      TFEL_TESTS_CHECK_EQUAL(s.bounds_status, -1);
    }
    TFEL_TESTS_CHECK_EQUAL(
        std::string(output.msg),
        "TK is below its physical lower bound at point 0 (1 failure(s), 0 "
        "unreliable result(s))");
    TFEL_TESTS_ASSERT(std::isnan(E[0]));
    TFEL_TESTS_ASSERT(std::isnan(E_qt[0]));
    for (std::size_t i = 1; i != E.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
      TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[i])) < eps);
    }
  }

  // failures and unreliable results in the same batch: the first failure
  // is reported, both indices are given
  void test6() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto statuses = test_vector<int>(4, 12);
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{300, 300, 3000, 300};
    const auto f = test_vector<double>{0, 2, 0.1, 0.1};
    const auto args = std::array<const double*, 2u>{T.data(), f.data()};
    const auto r = evaluate(UO2_YoungModulus_Martin1989_generic_parallel,
                            output, E.data(), 1, args, contiguous<2>(), 4,
                            GENERIC_MATERIALPROPERTY_WARNING_POLICY,
                            testExecution(), statuses.data());
    TFEL_TESTS_CHECK_EQUAL(r, -1);
    TFEL_TESTS_CHECK_EQUAL(output.status, -1);
    // the porosity, second argument, is out of its physical bounds
    TFEL_TESTS_CHECK_EQUAL(output.bounds_status, -2);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(output.first_failure_index, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(output.number_of_unreliable_results,
                           mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(output.first_unreliable_result_index,
                           mfront_gmp_size_type{2});
    const auto expected = std::array<int, 4u>{0, -1, 1, 0};
    for (std::size_t i = 0; i != 4; ++i) {
      TFEL_TESTS_CHECK_EQUAL(statuses[i], expected[i]);
    }
    TFEL_TESTS_ASSERT(std::isnan(E[1]));
    for (const auto i : {0, 2, 3}) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - uo2_young(T[i], f[i])) <
                        eps * std::abs(uo2_young(T[i], f[i])));
    }
  }

  // strided arguments and output: the values between two values of the
  // output are not modified
  void test7() {
    constexpr auto eps = double{1e-2};
    constexpr auto v = double{-1};
    auto output = mfront_gpmp_OutputStatus{};
    auto output_qt = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4 * 3, v);
    auto E_qt = test_vector<double>(4 * 3, v);
    const auto T =
        test_vector<double>{300, -300, 500, -500, 300, -300, 800, -800};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto strides = std::array<mfront_gmp_size_type, 1u>{2};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 3,
                 args, strides, 4, policy, testExecution());
    const auto r_qt =
        evaluate(Inconel600_YoungModulus_qt_generic_parallel, output_qt,
                 E_qt.data(), 3, args, strides, 4, policy, testExecution());
    this->checkSuccess(output, r);
    this->checkSuccess(output_qt, r_qt);
    for (std::size_t i = 0; i != E.size(); ++i) {
      if (i % 3 == 0) {
        TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[(i / 3) * 2])) < eps);
        TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[(i / 3) * 2])) < eps);
      } else {
        TFEL_TESTS_CHECK_EQUAL(E[i], v);
        TFEL_TESTS_CHECK_EQUAL(E_qt[i], v);
      }
    }
  }

  // errors of the batch: nothing is computed, the statuses of the points
  // are not written
  void test8() {
    auto output = mfront_gpmp_OutputStatus{};
    auto statuses = test_vector<int>(10, 12);
    auto E = test_vector<double>(10, 3);
    const auto T = test_vector<double>(10, 300);
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 1u>{T.data()};
    auto check = [&](const int r, const std::string& msg) {
      TFEL_TESTS_CHECK_EQUAL(r, -5);
      TFEL_TESTS_CHECK_EQUAL(output.status, -5);
      TFEL_TESTS_CHECK_EQUAL(std::string(output.msg), msg);
      for (std::size_t i = 0; i != E.size(); ++i) {
        TFEL_TESTS_CHECK_EQUAL(E[i], 3.);
        TFEL_TESTS_CHECK_EQUAL(statuses[i], 12);
      }
    };
    const auto f = Inconel600_YoungModulus_generic_parallel;
    check(evaluate(f, output, E.data(), 1, args, contiguous<1>(), 1, policy,
                   testExecution(), statuses.data(), 3),
          "invalid number of arguments (3 given, 1 expected)");
    check(evaluate(f, output, E.data(), 0, args, contiguous<1>(), 10, policy,
                   testExecution(), statuses.data()),
          "if the output is uniform, the number of points must be equal to "
          "one (10 given)");
    check(evaluate(f, output, nullptr, 1, args, contiguous<1>(), 10, policy,
                   testExecution(), statuses.data()),
          "no output values given");
    const auto null_args = std::array<const double*, 1u>{nullptr};
    check(evaluate(f, output, E.data(), 1, null_args, contiguous<1>(), 10,
                   policy, testExecution(), statuses.data()),
          "no values given for argument 'Temperature'");
    // first number of points above the limit (2^48 - 1)
    const auto n =
        mfront_gmp_size_type{::mfront::gpmp::maximal_number_of_points} + 1;
    check(evaluate(f, output, E.data(), 1, args, contiguous<1>(), n, policy,
                   testExecution(), statuses.data()),
          "too many points (" + std::to_string(n) + " given)");
    check(f(&output, nullptr), "no batch data given");
    auto d = mfront_gpmp_BatchData{
        .number_of_points = 10,
        .output = mfront_gpmp_Field{.values = E.data(), .point_stride = 1},
        .arguments = nullptr,
        .number_of_arguments = 1,
        .out_of_bounds_policy = policy,
        .statuses = statuses.data(),
        .statistics = testExecution().statistics,
        .execution_policy = testExecution().policy};
    check(f(&output, &d), "no arguments given");
    // an empty batch is accepted without any check
    d.number_of_points = 0;
    d.output.values = nullptr;
    d.number_of_arguments = 12;
    TFEL_TESTS_CHECK_EQUAL(f(&output, &d), 0);
    TFEL_TESTS_CHECK_EQUAL(output.status, 0);
  }

  // material property without argument
  void test9() {
    constexpr auto eps = double{1e-14};
    auto output = mfront_gpmp_OutputStatus{};
    auto nu = test_vector<double>(4);
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto r = evaluate(PoissonRatioTest_generic_parallel, output,
                            nu.data(), 1, std::array<const double*, 0u>{},
                            std::array<mfront_gmp_size_type, 0u>{}, 4, policy,
                            testExecution());
    this->checkSuccess(output, r);
    for (std::size_t i = 0; i != nu.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(nu[i] - 0.39991) < eps);
    }
    nu.resize(1);
    nu.at(0) = 0;
    const auto r2 = evaluate(PoissonRatioTest_generic_parallel, output,
                             nu.data(), 0, std::array<const double*, 0u>{},
                             std::array<mfront_gmp_size_type, 0u>{}, 1, policy,
                             testExecution());
    this->checkSuccess(output, r2);
    TFEL_TESTS_ASSERT(std::abs(nu[0] - 0.39991) < eps);
  }

  // invalid result: as with the `generic` interface, the output is the
  // computed value. Contrary to the `generic` interface, the bounds status is
  // null, even if a bound is violated with the warning policy at this point.
  void test10() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto statuses = test_vector<int>(4, 12);
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{300, 1e200, 500, 800};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r =
        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
                 args, contiguous<1>(), 4, GENERIC_MATERIALPROPERTY_NONE_POLICY,
                 testExecution(), statuses.data());
    TFEL_TESTS_CHECK_EQUAL(r, -4);
    TFEL_TESTS_CHECK_EQUAL(output.status, -4);
    TFEL_TESTS_CHECK_EQUAL(output.bounds_status, 0);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(output.first_failure_index, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(
        std::string(output.msg),
        "invalid result at point 1 (1 failure(s), 0 unreliable result(s))");
    TFEL_TESTS_ASSERT(std::isinf(E[1]));
    const auto expected = std::array<int, 4u>{0, -4, 0, 0};
    for (std::size_t i = 0; i != 4; ++i) {
      TFEL_TESTS_CHECK_EQUAL(statuses[i], expected[i]);
      if (i != 1) {
        TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
      }
    }
    // bound violated with the warning policy, then invalid result
    const auto T2 = test_vector<double>{1e200};
    const auto f2 = test_vector<double>{0.1};
    const auto args2 = std::array<const double*, 2u>{T2.data(), f2.data()};
    const auto r2 =
        evaluate(UO2_YoungModulus_Martin1989_generic_parallel, output, E.data(),
                 1, args2, contiguous<2>(), 1,
                 GENERIC_MATERIALPROPERTY_WARNING_POLICY, testExecution());
    TFEL_TESTS_CHECK_EQUAL(r2, -4);
    TFEL_TESTS_CHECK_EQUAL(output.bounds_status, 0);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_unreliable_results,
                           mfront_gmp_size_type{0});
  }

  void test11() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{300, 500, 300, 800};
    const auto f = test_vector<double>{0, 0.1, 0.15, 0.12};
    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
    const auto args = std::array<const double*, 2u>{T.data(), f.data()};
    const auto r =
        evaluate(UO2_YoungModulus_Martin1989_generic_parallel, output, E.data(),
                 1, args, contiguous<2>(), 4, policy, testExecution());
    this->checkSuccess(output, r);
    for (std::size_t i = 0; i != E.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - uo2_young(T[i], f[i])) < eps);
    }
  }

