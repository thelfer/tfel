    }
  }

  // report function: invalid and empty statistics
  void test14() {
    auto output = mfront_gpmp_OutputStatus{};
    TFEL_TESTS_CHECK_EQUAL(
        Inconel600_YoungModulus_generic_parallel_report(&output, nullptr), -5);
    TFEL_TESTS_CHECK_EQUAL(output.status, -5);
    TFEL_TESTS_CHECK_EQUAL(std::string(output.msg), "no statistics given");
    auto statistics = mfront_gpmp_Statistics{};
    mfront_gpmp_initializeStatistics(&statistics);
    const auto r =
        Inconel600_YoungModulus_generic_parallel_report(&output, &statistics);
    this->checkSuccess(output, r);
    TFEL_TESTS_CHECK_EQUAL(std::string(output.msg), "");
  }

  // bound violated with the strict policy: the evaluation fails
  void test15() {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{300, 3000, 300, 100};
    const auto f = test_vector<double>{0, 0.1, 0.15, 0.12};
    const auto args = std::array<const double*, 2u>{T.data(), f.data()};
    const auto r =
        evaluate(UO2_YoungModulus_Martin1989_generic_parallel, output, E.data(),
                 1, args, contiguous<2>(), 4,
                 GENERIC_MATERIALPROPERTY_STRICT_POLICY, testExecution());
    TFEL_TESTS_CHECK_EQUAL(r, -1);
    TFEL_TESTS_CHECK_EQUAL(output.bounds_status, -1);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{2});
    TFEL_TESTS_CHECK_EQUAL(output.first_failure_index, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(
        std::string(output.msg),
        "T is over its upper bound at point 1 (2 failure(s), 0 unreliable "
        "result(s))");
    TFEL_TESTS_ASSERT(std::isnan(E[1]));
    TFEL_TESTS_ASSERT(std::isnan(E[3]));
    for (const auto i : {0, 2}) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - uo2_young(T[i], f[i])) <
                        eps * std::abs(uo2_young(T[i], f[i])));
    }
  }

  // order of the checks, as with the `generic` interface (bounds and
  // physical bounds on both arguments and on the output of
  // BoundsOrderTest, z = x - y): the first check making the evaluation fail
  // is retained, otherwise the last bound violated with the warning policy
  void test16() {
    constexpr auto eps = double{1e-14};
    const auto f = BoundsOrderTest_generic_parallel;
    auto evaluate_points = [this, f](const test_vector<double>& x,
                                     const test_vector<double>& y,
                                     test_vector<double>& z,
                                     test_vector<int>& statuses,
                                     const mfront_gmp_OutOfBoundsPolicy p) {
      auto output = mfront_gpmp_OutputStatus{};
      const auto args = std::array<const double*, 2u>{x.data(), y.data()};
      const auto r = evaluate(f, output, z.data(), 1, args, contiguous<2>(),
                              x.size(), p, testExecution(), statuses.data());
      TFEL_TESTS_CHECK_EQUAL(r, output.status);
      return output;
    };
    // success, bounds of both arguments (rank 2 retained), bounds of the
    // output (rank 3), physical bounds of the output (rank -3), physical
    // bounds of the first argument (rank -1)
    const auto x = test_vector<double>{0.5, 1.5, 0.9, 3, -2};
    const auto y = test_vector<double>{0.5, 1.2, -0.5, 0, 1.5};
    auto z = test_vector<double>(5);
    auto statuses = test_vector<int>(5, 12);
    const auto s = evaluate_points(x, y, z, statuses,
                                   GENERIC_MATERIALPROPERTY_WARNING_POLICY);
    TFEL_TESTS_CHECK_EQUAL(s.status, -1);
    TFEL_TESTS_CHECK_EQUAL(s.bounds_status, -3);
    TFEL_TESTS_CHECK_EQUAL(s.number_of_failures, mfront_gmp_size_type{2});
    TFEL_TESTS_CHECK_EQUAL(s.first_failure_index, mfront_gmp_size_type{3});
    TFEL_TESTS_CHECK_EQUAL(s.number_of_unreliable_results,
                           mfront_gmp_size_type{2});
    TFEL_TESTS_CHECK_EQUAL(s.first_unreliable_result_index,
                           mfront_gmp_size_type{1});
    const auto expected_statuses = std::array<int, 5u>{0, 1, 1, -1, -1};
    for (std::size_t i = 0; i != 5; ++i) {
      TFEL_TESTS_CHECK_EQUAL(statuses[i], expected_statuses[i]);
      if (expected_statuses[i] < 0) {
        TFEL_TESTS_ASSERT(std::isnan(z[i]));
      } else {
        TFEL_TESTS_ASSERT(std::abs(z[i] - (x[i] - y[i])) < eps);
      }
    }
    // the last bound violated with the warning policy is retained: the
    // second argument, then the output
    for (const auto& [xv, yv, rank] :
         {std::tuple{1.5, 1.2, 2}, std::tuple{0.9, -0.5, 3}}) {
      const auto x1 = test_vector<double>{xv};
      const auto y1 = test_vector<double>{yv};
      auto z1 = test_vector<double>(1);
      auto s1 = test_vector<int>(1, 12);
      const auto o = evaluate_points(x1, y1, z1, s1,
                                     GENERIC_MATERIALPROPERTY_WARNING_POLICY);
      TFEL_TESTS_CHECK_EQUAL(o.status, 1);
      TFEL_TESTS_CHECK_EQUAL(o.bounds_status, rank);
      TFEL_TESTS_CHECK_EQUAL(s1[0], 1);
    }
    // with the strict policy, the first violated bound ends the evaluation
    const auto x2 = test_vector<double>{0.9};
    const auto y2 = test_vector<double>{-0.5};
    auto z2 = test_vector<double>(1);
    auto s2 = test_vector<int>(1, 12);
    const auto o2 =
        evaluate_points(x2, y2, z2, s2, GENERIC_MATERIALPROPERTY_STRICT_POLICY);
    TFEL_TESTS_CHECK_EQUAL(o2.status, -1);
    TFEL_TESTS_CHECK_EQUAL(o2.bounds_status, -2);
    TFEL_TESTS_ASSERT(std::isnan(z2[0]));
  }

  /*!
   * \brief evaluate a material property depending on the temperature at four
   * points and compare the results to reference values
   * \param[in] mp: material property
   * \param[in] T_values: temperatures
   * \param[in] references: reference values
   */
  void checkTemperatureDependentMaterialProperty(
      const mfront_gpmp_BatchMaterialPropertyPtr mp,
      const std::array<double, 4u>& T_values,
      const std::array<double, 4u>& references) {
    constexpr auto eps = double{1e-2};
    auto output = mfront_gpmp_OutputStatus{};
    auto v = test_vector<double>(T_values.size());
    const auto T = test_vector<double>(T_values.begin(), T_values.end());
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r =
        evaluate(mp, output, v.data(), 1, args, contiguous<1>(), T.size(),
                 mfront_gmp_OutOfBoundsPolicy{}, testExecution());
    this->checkSuccess(output, r);
    for (std::size_t i = 0; i != v.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(v[i] - references[i]) < eps);
    }
  }
};

TFEL_TESTS_GENERATE_PROXY(GenericParallelMaterialPropertyTest,
                          "GenericParallelMaterialPropertyTest");

//! \brief execution policy of a backend which is not the one of the library
struct OtherBackendExecutionPolicy final
    : mfront::generic_parallel::AbstractBackendExecutionPolicy {
  const char* getIdentifier() const noexcept override {
    return "other backend";
  }
};

//! \brief execution policies given to the generated functions
struct ExecutionPolicyTest : public tfel::tests::TestCase {
  ExecutionPolicyTest()
      : tfel::tests::TestCase("MFront/MaterialProperty/GenericParallel",
                              "ExecutionPolicyTest") {
  }  // end of ExecutionPolicyTest

  tfel::tests::TestResult execute() override {
    this->test1();
    this->test2();
    this->test3();
    this->test4();
    return this->result;
  }  // end of execute

 private:
  [[nodiscard]] static double fct(const double TK) noexcept {
    const double TC = TK - 273.15;
    return (-3.1636e-3 * TC * TC - 3.8654 * TC + 2.1421e+4) * 1e7;
  }  // end of fct

  void test1() {
    // identifier of the policy expected by the library
    const auto p = makeTestPolicy({});
    TFEL_TESTS_CHECK_EQUAL(
        std::string{Inconel600_YoungModulus_generic_parallel_execution_policy},
        std::string{p->getIdentifier()});
  }

  void test2() {
    // a policy of another backend is an invalid argument: nothing is
    // computed
    namespace mgp = mfront::generic_parallel;
    const auto stlpar =
        std::string_view{
            Inconel600_YoungModulus_generic_parallel_execution_policy} ==
        mgp::ParallelSTLBackendExecutionPolicy::identifier();
    const auto other =
        stlpar
            ? std::unique_ptr<mgp::AbstractBackendExecutionPolicy>(
                  std::make_unique<OtherBackendExecutionPolicy>())
            : std::unique_ptr<mgp::AbstractBackendExecutionPolicy>(
                  std::make_unique<mgp::ParallelSTLBackendExecutionPolicy>());
    this->checkInvalidPolicy(
        TestExecution{.policy = other.get()},
        "the execution policy is not the one of the backend");
  }

  void test3() {
    // an asynchronous evaluation requires statistics
    const auto p = makeTestPolicy({.asynchronous = true});
    this->checkInvalidPolicy(TestExecution{.policy = p.get()},
                             "an asynchronous computation requires statistics");
  }

  void test4() {
    // synchronous evaluation with statistics: the function returns once the
    // values are computed, the output status only reports the errors of the
    // batch, and the result is given by the report function. The second
    // temperature is out of its physical bounds.
    constexpr auto eps = double{1e-2};
    auto statistics = test_vector<mfront_gpmp_Statistics>(1);
    mfront_gpmp_initializeStatistics(statistics.data());
    const auto p = makeTestPolicy({});
    auto output = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(4);
    const auto T = test_vector<double>{300, -1, 500, 800};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r = evaluate(
        Inconel600_YoungModulus_generic_parallel, output, E.data(), 1, args,
        contiguous<1>(), 4, mfront_gmp_OutOfBoundsPolicy{},
        TestExecution{.statistics = statistics.data(), .policy = p.get()});
    TFEL_TESTS_CHECK_EQUAL(r, 0);
    TFEL_TESTS_CHECK_EQUAL(output.status, 0);
    for (const auto i : {0, 2, 3}) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
    }
    TFEL_TESTS_ASSERT(std::isnan(E[1]));
    TFEL_TESTS_CHECK_EQUAL(Inconel600_YoungModulus_generic_parallel_report(
                               &output, statistics.data()),
                           -1);
    TFEL_TESTS_CHECK_EQUAL(output.status, -1);
    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{1});
    TFEL_TESTS_CHECK_EQUAL(output.first_failure_index, mfront_gmp_size_type{1});
  }

  /*!
   * \brief check that an evaluation is refused as an invalid argument,
   * nothing being computed
   * \param[in] e: execution of the evaluation
   * \param[in] msg: expected error message
   */
  void checkInvalidPolicy(const TestExecution& e, const std::string& msg) {
    auto output = mfront_gpmp_OutputStatus{};
    auto E = test_vector<double>(2, 3);
    auto statuses = test_vector<int>(2, 12);
    const auto T = test_vector<double>{300, 500};
    const auto args = std::array<const double*, 1u>{T.data()};
    const auto r = evaluate(Inconel600_YoungModulus_generic_parallel, output,
                            E.data(), 1, args, contiguous<1>(), 2,
                            mfront_gmp_OutOfBoundsPolicy{}, e, statuses.data());
    TFEL_TESTS_CHECK_EQUAL(r, -5);
    TFEL_TESTS_CHECK_EQUAL(output.status, -5);
    TFEL_TESTS_CHECK_EQUAL(std::string(output.msg), msg);
    for (std::size_t i = 0; i != 2; ++i) {
      TFEL_TESTS_CHECK_EQUAL(E[i], 3.);
      TFEL_TESTS_CHECK_EQUAL(statuses[i], 12);
    }
  }
};

TFEL_TESTS_GENERATE_PROXY(ExecutionPolicyTest, "ExecutionPolicyTest");

