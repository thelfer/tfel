    TFEL_TESTS_CHECK_EQUAL(output.first_unreliable_result_index,
                           mfront_gmp_size_type{1});
    for (std::size_t i = 0; i != E.size(); ++i) {
      TFEL_TESTS_ASSERT(std::abs(E[i] - uo2_young(T[i], f[i])) <
