set(TFEL_MTEST_CYRANO_SUPPORT @HAVE_CYRANO@)
if(TFEL_MTEST_CYRANO_SUPPORT)
  find_package(CyranoInterface REQUIRED
    HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
