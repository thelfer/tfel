if(TFEL_MTEST_ASTER_SUPPORT)
  find_package(AsterInterface REQUIRED
    HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
endif(TFEL_MTEST_ASTER_SUPPORT)

set(TFEL_MTEST_ABAQUS_SUPPORT @HAVE_ABAQUS@)
if(TFEL_MTEST_ABAQUS_SUPPORT)
  find_package(AbaqusInterface REQUIRED
    HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
endif(TFEL_MTEST_ABAQUS_SUPPORT)

set(TFEL_MTEST_ANSYS_SUPPORT @HAVE_ANSYS@)
if(TFEL_MTEST_ANSYS_SUPPORT)
  find_package(AnsysInterface REQUIRED
    HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
