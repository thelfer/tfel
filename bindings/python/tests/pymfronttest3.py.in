try:
    import unittest2 as unittest
except ImportError:
    import unittest

import @mfront_python_module@ as mfront

class PyMFrontTest3(unittest.TestCase):

    def test_pass(self):
        f   = '@top_srcdir@/mfront/tests/behaviours/ImplicitMonoCrystal.mfront'
        dsl = mfront.getDSL(f)
        dsl.analyseFile(f,[])

        # behaviour description
        bd = dsl.getBehaviourDescription()
        self.assertTrue(bd.hasAttribute('requiresStiffnessTensor'))
        self.assertTrue(bd.getBooleanAttribute('requiresStiffnessTensor',False))

    def test_material_property(self):
        f   = '@top_srcdir@/mfront/tests/properties/Inconel600_YoungModulus.mfront'
        dsl = mfront.getDSL(f)
        self.assertEqual(dsl.getTargetType(),
                         mfront.DSLTarget.MATERIALPROPERTYDSL)
        dsl.analyseFile(f,[])
        self.assertEqual(dsl.getFileDescription().fileName,f)
        md = dsl.getMaterialPropertyDescription()
        self.assertEqual(md.getLawName(),'YoungModulus')

    def test_material_property_unit_system(self):
        # the physical bounds deduced from the unit system do not depend on
        # the position of @UnitSystem
        f   = mfront.DSLFactory.getDSLFactory()
        dsl = f.createNewDSL('MaterialLaw')
        dsl.analyseString('@Law L;\n@Input T;\n'
                          'T.setGlossaryName("Temperature");\n'
                          '@Function{ res = T; }\n@UnitSystem SI;\n')
        inputs = [v for v in dsl.getMaterialPropertyDescription().getInputs()]
        self.assertEqual(len(inputs),1)
        self.assertTrue(inputs[0].hasPhysicalBounds())
        
if __name__ == '__main__':
    unittest.main()
