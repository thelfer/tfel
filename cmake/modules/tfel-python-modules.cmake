if(TFEL_APPEND_SUFFIX)
  if(unversioned-python-module-names)
    set(TFEL_PYTHON_MODULES_APPEND_SUFFIX OFF)
  else(unversioned-python-module-names)
    set(TFEL_PYTHON_MODULES_APPEND_SUFFIX ON)
    string(REPLACE "." "_" TFEL_SUFFIX_FOR_PYTHON_MODULES "${TFEL_SUFFIX}")
    string(REPLACE "-" "_" TFEL_SUFFIX_FOR_PYTHON_MODULES "${TFEL_SUFFIX_FOR_PYTHON_MODULES}")
    tfel_add_c_cxx_definitions("TFEL_SUFFIX_FOR_PYTHON_MODULES=${TFEL_SUFFIX_FOR_PYTHON_MODULES}")
  endif(unversioned-python-module-names)
else(TFEL_APPEND_SUFFIX)
  set(TFEL_PYTHON_MODULES_APPEND_SUFFIX OFF)
endif(TFEL_APPEND_SUFFIX)

# Root directory of the python modules in the build tree
set(TFEL_PYTHON_MODULES_BUILD_DIR "${PROJECT_BINARY_DIR}/bindings/python")

# Register a python module so that a stub file is generated for it using
# pybind11-stubgen by the generate_python_stubs function.
#
# Nothing is done if the enable-pybind11-stubgen option is OFF or if
# pybind11-stubgen has not been found.
#
# \param target target associated with the python module
# \param package path of the package which contains the module, using '/' as a
#        separator, such as tfel or tfel/material
# \param name name of the module, as it is imported by python
function(python_module_stubgen target package name)
  if(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
    return()
  endif(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
  # Only the first component of the name of the package and the name of the
  # module reflect the version and flavour information
  string(REPLACE "/" ";" components "${package}")
  if(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
    list(GET components 0 component)
    list(REMOVE_AT components 0)
    list(INSERT components 0 "${component}_${TFEL_SUFFIX_FOR_PYTHON_MODULES}")
    set(name "${name}_${TFEL_SUFFIX_FOR_PYTHON_MODULES}")
  endif(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
  string(REPLACE ";" "." package "${components}")
  set_property(GLOBAL APPEND PROPERTY TFEL_PYTHON_STUBGEN_MODULES
    "${target}:${package}.${name}")
endfunction(python_module_stubgen)

# Generate the stub files of all the python modules registered by the
# python_module_stubgen function using pybind11-stubgen and install them.
#
# The stubs are generated by the python-stubs target, which is built when the
# project is built.
#
# This function shall be called after all the calls to add_subdirectory as it
# requires that all the python modules and all the TFEL libraries have been
# declared.
#
# Nothing is done if the enable-pybind11-stubgen option is OFF or if
# pybind11-stubgen has not been found.
function(generate_python_stubs)
  if(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
    return()
  endif(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
  get_property(TFEL_PYTHON_STUBGEN_MODULES
    GLOBAL PROPERTY TFEL_PYTHON_STUBGEN_MODULES)
  if(NOT TFEL_PYTHON_STUBGEN_MODULES)
    return()
  endif(NOT TFEL_PYTHON_STUBGEN_MODULES)
  # Importing a python module triggers the execution of the __init__.py script
  # of the package, which usually imports the other modules of the package.
  # Hence all the python modules must be built before a stub can be generated.
  set(pybind11_stubgen_dependencies)
  foreach(entry ${TFEL_PYTHON_STUBGEN_MODULES})
    string(REGEX REPLACE ":.*$" "" target "${entry}")
    list(APPEND pybind11_stubgen_dependencies "${target}")
  endforeach(entry ${TFEL_PYTHON_STUBGEN_MODULES})
  # the environment variables passed to pybind11-stubgen
  set(tfel_stubgen_pythonpath "${TFEL_PYTHON_MODULES_BUILD_DIR}")
  if(WIN32)
    # On windows, the directories containing the dynamic link libraries of
    # the build tree, which the python modules depend on, are neither those
    # of the python interpreter nor those of the python modules. The python
    # interpreter ignores the PATH variable when it imports an extension
    # module, but the directories can be added to the search path of the
    # dynamic loader with the os.add_dll_directory function. This is done by
    # a sitecustomize script, which is placed in a directory added to the
    # PYTHONPATH variable for the execution of pybind11-stubgen.
    get_property(tfel_stubgen_libraries GLOBAL PROPERTY TFEL_LIBRARIES)
    set(tfel_stubgen_library_directories)
    foreach(tfel_stubgen_library ${tfel_stubgen_libraries})
      list(APPEND tfel_stubgen_library_directories
           "$<TARGET_FILE_DIR:${tfel_stubgen_library}>")
    endforeach(tfel_stubgen_library ${tfel_stubgen_libraries})
    string(JOIN "\", r\"" tfel_stubgen_library_directories
           ${tfel_stubgen_library_directories})
    set(tfel_stubgen_sitecustomize_directory
        "${PROJECT_BINARY_DIR}/bindings/stubgen/$<CONFIG>")
    file(GENERATE
      OUTPUT "${tfel_stubgen_sitecustomize_directory}/sitecustomize.py"
      CONTENT "import os

for _directory in dict.fromkeys((r\"${tfel_stubgen_library_directories}\", )):
    if os.path.isdir(_directory):
        os.add_dll_directory(_directory)
")
    set(tfel_stubgen_pythonpath
        "${tfel_stubgen_sitecustomize_directory};${TFEL_PYTHON_MODULES_BUILD_DIR}")
  endif(WIN32)
  # The PYTHONPATH variable is extended, not replaced: pybind11-stubgen may
  # only be found through it, as in the isolated build environments of pip.
  if(NOT "$ENV{PYTHONPATH}" STREQUAL "")
    if(WIN32)
      string(APPEND tfel_stubgen_pythonpath ";$ENV{PYTHONPATH}")
    else(WIN32)
      string(APPEND tfel_stubgen_pythonpath ":$ENV{PYTHONPATH}")
    endif(WIN32)
  endif()
  # the paths of the PYTHONPATH variable are separated by a semicolon on windows
  string(REPLACE ";" "$<SEMICOLON>" tfel_stubgen_pythonpath
         "${tfel_stubgen_pythonpath}")
  set(pybind11_stubgen_files)
  set(pybind11_stubgen_packages)
  foreach(entry ${TFEL_PYTHON_STUBGEN_MODULES})
    string(REGEX REPLACE "^[^:]*:" "" module "${entry}")
    string(REPLACE "." "/" module_path "${module}")
    set(stub_file "${TFEL_PYTHON_MODULES_BUILD_DIR}/${module_path}.pyi")
    get_filename_component(stub_directory "${stub_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${stub_directory}")
    file(RELATIVE_PATH install_directory
      "${TFEL_PYTHON_MODULES_BUILD_DIR}" "${stub_directory}")
    add_custom_command(OUTPUT "${stub_file}"
      COMMAND "${CMAKE_COMMAND}" -E env
              "PYTHONPATH=${tfel_stubgen_pythonpath}"
              "${Python_EXECUTABLE}" -m pybind11_stubgen "${module}"
              "--output-dir" "${TFEL_PYTHON_MODULES_BUILD_DIR}"
      DEPENDS ${pybind11_stubgen_dependencies}
      COMMENT "Generating stub for python module ${module}"
      VERBATIM)
    list(APPEND pybind11_stubgen_files "${stub_file}")
    string(REGEX REPLACE "/.*$" "" package "${module_path}")
    list(APPEND pybind11_stubgen_packages "${package}")
    install(FILES "${stub_file}"
      DESTINATION "${TFEL_PYTHON_SITE_PACKAGES_DIR}/${install_directory}"
      COMPONENT python_bindings)
  endforeach(entry ${TFEL_PYTHON_STUBGEN_MODULES})
  # According to PEP 561, type checkers only use the stubs of an installed
  # package if it holds a py.typed marker.
  list(REMOVE_DUPLICATES pybind11_stubgen_packages)
  foreach(package ${pybind11_stubgen_packages})
    set(marker "${TFEL_PYTHON_MODULES_BUILD_DIR}/${package}/py.typed")
    file(TOUCH "${marker}")
    install(FILES "${marker}"
      DESTINATION "${TFEL_PYTHON_SITE_PACKAGES_DIR}/${package}"
      COMPONENT python_bindings)
  endforeach(package ${pybind11_stubgen_packages})
  add_custom_target(python-stubs ALL
    DEPENDS ${pybind11_stubgen_files})
endfunction(generate_python_stubs)

function(python_module_base fullname name)
  if(${ARGC} LESS 1)
    message(FATAL_ERROR "python_lib_module : no source specified")
  endif(${ARGC} LESS 1)
  add_library(py_${fullname} MODULE ${ARGN})
  target_link_libraries(py_${fullname} PRIVATE
    pybind11::module pybind11::windows_extras)
  if(TARGET pybind11::lto)
    target_link_libraries(py_${fullname} PRIVATE pybind11::lto)
  endif(TARGET pybind11::lto)
  pybind11_extension(py_${fullname})
  if(NOT MSVC AND NOT ${CMAKE_BUILD_TYPE} MATCHES Debug|RelWithDebInfo)
    # Strip unnecessary sections of the binary on Linux/macOS
    pybind11_strip(py_${fullname})
  endif()
  set_target_properties(py_${fullname} PROPERTIES PREFIX "")
  if(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
    set_target_properties(py_${fullname} PROPERTIES OUTPUT_NAME "${name}_${TFEL_SUFFIX_FOR_PYTHON_MODULES}")
  else(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
    set_target_properties(py_${fullname} PROPERTIES OUTPUT_NAME ${name})
  endif(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
  set_target_properties(py_${fullname} PROPERTIES
    CXX_VISIBILITY_PRESET "hidden"
    CUDA_VISIBILITY_PRESET "hidden")
  # The modules shall be next to the __init__.py script of their package, which
  # imports them. Multi-configuration generators append the name of the
  # configuration to the output directory, unless it holds a generator
  # expression.
  set_target_properties(py_${fullname} PROPERTIES
    LIBRARY_OUTPUT_DIRECTORY "$<1:${CMAKE_CURRENT_BINARY_DIR}>")
endfunction(python_module_base)

function(python_lib_module name package)
  python_module_base(${package}_${name} ${name} ${ARGN})
  if(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
    install(TARGETS py_${package}_${name}
      DESTINATION ${TFEL_PYTHON_SITE_PACKAGES_DIR}/${package}_${TFEL_SUFFIX_FOR_PYTHON_MODULES}
      COMPONENT python_bindings)
  else(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
    install(TARGETS py_${package}_${name}
       DESTINATION ${TFEL_PYTHON_SITE_PACKAGES_DIR}/${package}
       COMPONENT python_bindings)
  endif(TFEL_PYTHON_MODULES_APPEND_SUFFIX)
  python_module_stubgen(py_${package}_${name} ${package} ${name})
endfunction(python_lib_module)

