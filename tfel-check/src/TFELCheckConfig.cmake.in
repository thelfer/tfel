  HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
find_package(TFELUtilities REQUIRED
  HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
find_package(TFELSystem REQUIRED
  HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")
find_package(TFELConfig REQUIRED
  HINTS "${CMAKE_CURRENT_LIST_DIR}" "${TFEL_MODULE_PATH}")

include("${CMAKE_CURRENT_LIST_DIR}/TFELCheckTargets.cmake")
